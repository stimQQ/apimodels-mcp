{
  "name": "apimodels-mcp",
  "version": "0.2.1",
  "description": "MCP server for apimodels.app — call image, video, LLM chat and text-to-speech models with one API key, from Claude Desktop, Cursor and any MCP client.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://apimodels.app",
  "bin": {
    "apimodels-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apimodels",
    "ai",
    "llm",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "claude",
    "cursor"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stimQQ/apimodels-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/stimQQ/apimodels-mcp/issues"
  },
  "mcpName": "io.github.stimQQ/apimodels-mcp"
}
